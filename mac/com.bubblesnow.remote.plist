<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- Claude Code をサーバーモードで常駐させる。
       スマホ／クラウドのセッションはここに繋いで Mac を動かす。
       Mac から外向きに接続するので、ポート開放もファイアウォールの変更も要らない。 -->
  <!-- env -u で、推論専用の資格情報を確実に外す。
       Remote Control には full-scope のログインが要る。API キーや、
       claude setup-token で作る長期トークン（CLAUDE_CODE_OAUTH_TOKEN）が
       環境にあると claude はそちらで認証し、ログイン済みでも拒否される。
       この Mac で実際に踏んだのが後者。launchd はシェルの環境を継承しないので
       普通は入り込まないが、launchctl setenv で仕込まれている場合もあるため
       ここで断ち切る。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>-u</string>
    <string>ANTHROPIC_API_KEY</string>
    <string>-u</string>
    <string>CLAUDE_CODE_OAUTH_TOKEN</string>
    <string>__CLAUDE__</string>
    <string>remote-control</string>
    <string>--name</string>
    <string>__NAME__</string>
    <string>--permission-mode</string>
    <string>acceptEdits</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- ログイン時に起動し、落ちたら起こし直す。
       「気づいたら繋がらない」を無くすのがこの常駐の目的なので KeepAlive は必須。 -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- 起動に失敗し続けるときに秒間ループで CPU を焼かないための間隔 -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/__LOG_BASE__.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/__LOG_BASE__.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd の PATH は痩せている。node と claude が見える形にする -->
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
